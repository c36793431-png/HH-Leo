# Auth.js
AUTH_SECRET=
# Required on Vercel — without it Auth.js can't reliably infer the request's
# protocol/host on preview URLs, causing a secure/non-secure session cookie
# name mismatch between middleware and page-level session checks (redirect loop).
AUTH_TRUST_HOST=true

# Telegram Login Widget — same bot as @horizonportalbot (Credentials provider validates the widget HMAC)
HORIZON_PORTAL_BOT_TOKEN=

# Email magic-link (Resend provider)
AUTH_RESEND_KEY=
EMAIL_FROM=

# Neon Postgres
NEON_DATABASE_URL=

# Installer download signed-URL HMAC secret (falls back to AUTH_SECRET if unset)
INSTALLER_URL_SECRET=

# Vercel Blob (installer storage)
BLOB_READ_WRITE_TOKEN=

# Upstash Redis (rate limiting for /api/verify-license — verify-license fails open if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Paid Users Group (bot must be supergroup admin with invite + ban rights)
TELEGRAM_PAID_GROUP_CHAT_ID=

# Vercel Cron auth — set the same value in Vercel's env vars; Vercel injects it as
# `Authorization: Bearer $CRON_SECRET` on cron-triggered requests automatically
CRON_SECRET=

# --- Desktop-client endpoints (/v1/validate, /v1/hb) ---

# Ed25519 PRIVATE key (PEM) for signing client responses (security finding #2:
# offline-verifiable, MITM-proof). The matching PUBLIC key is embedded in the C#
# client — private key NEVER ships in the client. Store as PEM with \n-escaped
# newlines or raw multiline. Generate:
#   openssl genpkey -algorithm ed25519 -out priv.pem
#   openssl pkey -in priv.pem -pubout -out pub.pem   # <- pub.pem goes in the client
LICENSE_SIGNING_PRIVATE_KEY=
# Optional key id for rotation (defaults to "k1")
LICENSE_SIGNING_KID=

# --- Telemetry sink (server-side replacement for bot-creds-in-binary, finding #3) ---
# Rotated bot token (@svc_relay9k_bot) — lives ONLY on the server, never in the client.
TELEMETRY_BOT_TOKEN=
# Operator's personal chat_id — obtained via getUpdates after DMing /start to the bot.
TELEMETRY_CHAT_ID=
