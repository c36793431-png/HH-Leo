# Auth.js
AUTH_SECRET=
# Required on Vercel — without it Auth.js can't reliably infer the request's
# protocol/host on preview URLs, causing a secure/non-secure session cookie
# name mismatch between middleware and page-level session checks (redirect loop).
AUTH_TRUST_HOST=true

# Telegram Login Widget — same bot as @horizonportalbot (Credentials provider validates the widget HMAC)
HORIZON_PORTAL_BOT_TOKEN=

# Email magic-link (Resend provider)
AUTH_RESEND_KEY=
EMAIL_FROM=

# Neon Postgres
NEON_DATABASE_URL=

# Installer download signed-URL HMAC secret (falls back to AUTH_SECRET if unset)
INSTALLER_URL_SECRET=

# Vercel Blob (installer storage)
BLOB_READ_WRITE_TOKEN=

# Upstash Redis (rate limiting for /api/verify-license — verify-license fails open if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Paid Users Group (bot must be supergroup admin with invite + ban rights)
TELEGRAM_PAID_GROUP_CHAT_ID=

# Vercel Cron auth — set the same value in Vercel's env vars; Vercel injects it as
# `Authorization: Bearer $CRON_SECRET` on cron-triggered requests automatically
CRON_SECRET=
